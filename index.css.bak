@tailwind base;
@tailwind components;
@tailwind utilities;

@layer base {
  :root {
    --background: 36 30% 95%;
    --foreground: 30 8% 10%;

    --card: 36 30% 97%;
    --card-foreground: 30 8% 10%;

    --popover: 36 30% 97%;
    --popover-foreground: 30 8% 10%;

    --primary: 152 50% 24%;
    --primary-foreground: 36 30% 95%;

    --secondary: 32 45% 58%;
    --secondary-foreground: 30 8% 10%;

    --muted: 36 18% 88%;
    --muted-foreground: 30 6% 38%;

    --accent: 14 55% 50%;
    --accent-foreground: 36 30% 95%;

    --destructive: 0 72% 51%;
    --destructive-foreground: 0 0% 100%;

    --border: 36 15% 82%;
    --input: 36 15% 85%;
    --ring: 152 50% 24%;

    --radius: 0.75rem;

    --sidebar-background: 36 30% 95%;
    --sidebar-foreground: 30 8% 10%;
    --sidebar-primary: 152 50% 24%;
    --sidebar-primary-foreground: 36 30% 95%;
    --sidebar-accent: 36 18% 88%;
    --sidebar-accent-foreground: 30 8% 10%;
    --sidebar-border: 36 15% 82%;
    --sidebar-ring: 152 50% 24%;

    --color-sand: #F7F3ED;
    --color-amber: #C9965E;
    --color-teal: #1E5941;
    --color-coral: #C46B52;
    --color-charcoal: #141414;
    --color-warm-gray: #5E5A55;
    --color-cream: #F0EBE1;
    --color-deep-forest: #143D2B;
    --color-gold: #B8944F;
  }

  * {
    @apply border-border;
  }

  html {
    scroll-behavior: smooth;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  body {
    @apply bg-background text-foreground;
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
    font-feature-settings: "kern" 1, "liga" 1;
    text-rendering: optimizeLegibility;
  }

  h1, h2, h3, h4, h5, h6 {
    font-family: 'Cormorant Garamond', Georgia, serif;
    font-weight: 500;
    letter-spacing: -0.01em;
    line-height: 1.15;
  }

  ::selection {
    background-color: hsl(var(--primary) / 0.2);
    color: hsl(var(--foreground));
  }
}

@layer components {
  .text-gradient {
    @apply bg-clip-text text-transparent;
    background-image: linear-gradient(135deg, hsl(var(--primary)) 0%, hsl(var(--accent)) 100%);
  }

  .glass-card {
    @apply bg-white/60 backdrop-blur-2xl border border-white/40 shadow-lg;
  }

  .section-padding {
    @apply px-4 sm:px-6 lg:px-8 xl:px-12 2xl:px-16;
  }

  .btn-primary {
    @apply inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-[hsl(var(--primary))] text-[hsl(var(--primary-foreground))] rounded-xl font-semibold text-sm tracking-wide transition-all duration-500;
    @apply hover:shadow-xl hover:shadow-[hsl(var(--primary))]/20 hover:-translate-y-0.5 active:translate-y-0;
    @apply relative overflow-hidden;
  }

  .btn-primary::after {
    content: '';
    @apply absolute inset-0 bg-white/10 opacity-0 transition-opacity duration-300;
  }

  .btn-primary:hover::after {
    @apply opacity-100;
  }

  .btn-secondary {
    @apply inline-flex items-center justify-center gap-2 px-7 py-3.5 bg-[hsl(var(--secondary))] text-[hsl(var(--secondary-foreground))] rounded-xl font-semibold text-sm tracking-wide transition-all duration-500;
    @apply hover:shadow-xl hover:-translate-y-0.5 active:translate-y-0;
  }

  .btn-outline {
    @apply inline-flex items-center justify-center gap-2 px-7 py-3.5 border-2 border-[hsl(var(--primary))] text-[hsl(var(--primary))] rounded-xl font-semibold text-sm tracking-wide transition-all duration-500;
    @apply hover:bg-[hsl(var(--primary))] hover:text-[hsl(var(--primary-foreground))];
  }

  .link-underline {
    @apply relative;
  }

  .link-underline::after {
    content: '';
    @apply absolute bottom-0 left-0 w-0 h-px bg-current transition-all duration-500;
  }

  .link-underline:hover::after {
    @apply w-full;
  }

  .grain-overlay {
    @apply pointer-events-none fixed inset-0 z-[100] opacity-[0.025];
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
    background-repeat: repeat;
    background-size: 256px 256px;
  }

  .image-reveal {
    @apply relative overflow-hidden;
  }

  .image-reveal::after {
    content: '';
    @apply absolute inset-0 bg-teal transform translate-y-full transition-transform duration-1000;
    transition-timing-function: cubic-bezier(0.76, 0, 0.24, 1);
  }

  .image-reveal.revealed::after {
    @apply translate-y-0;
  }

  .image-reveal.revealed img {
    @apply scale-100;
  }

  .image-reveal img {
    @apply scale-110 transition-transform duration-1000;
    transition-timing-function: cubic-bezier(0.76, 0, 0.24, 1);
  }
}

@layer utilities {
  .font-display {
    font-family: 'Cormorant Garamond', Georgia, serif;
  }

  .font-body {
    font-family: 'Plus Jakarta Sans', system-ui, sans-serif;
  }

  .text-balance {
    text-wrap: balance;
  }

  .animate-float {
    animation: float 6s ease-in-out infinite;
  }

  .animate-fade-in {
    animation: fadeIn 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .animate-slide-up {
    animation: slideUp 1s cubic-bezier(0.16, 1, 0.3, 1) forwards;
  }

  .animation-delay-100 {
    animation-delay: 100ms;
  }

  .animation-delay-200 {
    animation-delay: 200ms;
  }

  .animation-delay-300 {
    animation-delay: 300ms;
  }

  .animation-delay-400 {
    animation-delay: 400ms;
  }

  .animation-delay-500 {
    animation-delay: 500ms;
  }

  .animation-delay-600 {
    animation-delay: 600ms;
  }
}

@keyframes float {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-12px); }
}

@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes slideUp {
  from { opacity: 0; transform: translateY(50px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Custom scrollbar */
::-webkit-scrollbar {
  width: 8px;
}

::-webkit-scrollbar-track {
  background: hsl(var(--background));
}

::-webkit-scrollbar-thumb {
  background: hsl(var(--muted-foreground) / 0.3);
  border-radius: 4px;
}

::-webkit-scrollbar-thumb:hover {
  background: hsl(var(--muted-foreground) / 0.5);
}
